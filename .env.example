MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecoruta_app
MYSQL_PASSWORD=CAMBIAR
MYSQL_DATABASE=pac_ecoruta
JWT_SECRET_KEY=GENERAR_UN_SECRETO_ALEATORIO_LARGO
JWT_ALGORITHM=HS256
UPLOAD_DIR=
CORS_ORIGIN=http://localhost:8000
FCM_ENABLED=false
# Ruta absoluta al JSON de cuenta de servicio. También puede usar
# GOOGLE_APPLICATION_CREDENTIALS en vez de FIREBASE_CREDENTIALS.
FIREBASE_CREDENTIALS=C:\ruta\privada\ecoruta-firebase-admin.json
FIREBASE_PROJECT_ID=tu-proyecto-firebase
# true valida el mensaje con Firebase sin entregarlo; para la demo use false.
FCM_DRY_RUN=false
# Solo para pruebas locales; habilita el modo dev para omitir la validación GPS.
ALLOW_DEV_MODE=true
PORT=8000
LOG_LEVEL=INFO
